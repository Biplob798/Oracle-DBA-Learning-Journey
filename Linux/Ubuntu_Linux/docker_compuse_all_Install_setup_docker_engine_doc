# create dir from cluster user
sudo mkdir -p /u01

# give permission this folder to use cluster user

sudo chmod 755 /u01


# install Docker Engine first:
sudo apt update
sudo apt install -y ca-certificates curl git nano
sudo install -m 0755 -d /etc/apt/keyrings
sudo curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
sudo chmod a+r /etc/apt/keyrings/docker.asc


echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] \
https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo $VERSION_CODENAME) stable" \
| sudo tee /etc/apt/sources.list.d/docker.list > /dev/null


sudo apt update
sudo apt install -y docker-ce docker-ce-cli containerd.io \
  docker-buildx-plugin docker-compose-plugin


  # Create the folders in /u01


  sudo mkdir -p /u01/app /u01/docker-data
sudo chown -R cluster:cluster /u01/app
sudo chmod 755 /u01 /u01/app


# Move Docker's data to /u01/docker-data

sudo systemctl stop docker docker.socket
echo '{ "data-root": "/u01/docker-data" }' | sudo tee /etc/docker/daemon.json
sudo systemctl start docker
sudo systemctl enable docker

# for Check:
sudo docker info | grep "Docker Root Dir"


# Let cluster run Docker without sudo


