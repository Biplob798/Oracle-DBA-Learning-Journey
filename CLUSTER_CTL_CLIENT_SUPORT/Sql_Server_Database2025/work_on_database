# Step 5: Query the data

USE CompanyDB;
GO

-- 1. All employees
SELECT * FROM dbo.employees;

-- 2. Filter and sort
SELECT first_name, last_name, salary
FROM dbo.employees
WHERE salary > 10000
ORDER BY salary DESC;

-- 3. Join with departments
SELECT e.employee_id, e.first_name, e.last_name,
       d.department_name, e.salary
FROM dbo.employees e
JOIN dbo.departments d ON e.department_id = d.department_id
ORDER BY d.department_name, e.last_name;

-- 4. Count, average and total per department
SELECT d.department_name,
       COUNT(*)      AS employees,
       AVG(e.salary) AS avg_salary,
       SUM(e.salary) AS total_salary
FROM dbo.employees e
JOIN dbo.departments d ON e.department_id = d.department_id
GROUP BY d.department_name
ORDER BY total_salary DESC;

-- 5. Top 3 highest paid (Oracle: FETCH FIRST 3 ROWS ONLY)
SELECT TOP 3 first_name, last_name, salary
FROM dbo.employees
ORDER BY salary DESC;

-- 6. Hired in 2022
SELECT first_name, last_name, hire_date
FROM dbo.employees
WHERE hire_date >= '2022-01-01' AND hire_date < '2023-01-01';

-- 7. Highest paid person in each department
SELECT department_name, first_name, last_name, salary
FROM (
    SELECT d.department_name, e.first_name, e.last_name, e.salary,
           ROW_NUMBER() OVER (PARTITION BY e.department_id ORDER BY e.salary DESC) AS rn
    FROM dbo.employees e
    JOIN dbo.departments d ON e.department_id = d.department_id
) x
WHERE rn = 1;


#  Step 6: Test the new user

Run this as Administrator. EXECUTE AS makes your session act as app_user, and REVERT switches back.


USE CompanyDB;
GO
EXECUTE AS USER = 'app_user';
SELECT SUSER_NAME() AS login_name, USER_NAME() AS db_user;

SELECT COUNT(*) AS total_employees FROM dbo.employees;        -- works

BEGIN TRAN;
UPDATE dbo.employees SET salary = salary + 500 WHERE employee_id = 1;   -- works
ROLLBACK;                                                      -- undo it

CREATE TABLE dbo.should_fail (id INT);                         -- fails: permission denied
REVERT;
GO
SELECT SUSER_NAME() AS back_to;                                -- should show your Administrator login


