CREATE OR REPLACE PROCEDURE POLICY_MANAGEMENT.BANK_COLLECTION_SMS_PRE IS
NMSG1 VARCHAR2(200);
NMSG2 VARCHAR2(1000);
NMSG3 VARCHAR2(1000)  :=' Total Tk. ';
COLLECTION NUMBER     :=0;

NMSG VARCHAR2(1000);
TMSG VARCHAR2(1000)   :='';
BRAND_NAME    VARCHAR2(50)  :='ZENITH ISLAMI LIFE INSURANCE LIMITED.';
--BRAND_NAME    VARCHAR2(50)  :='';

CURSOR C1 IS SELECT SHORTNAME||' '||ACC_TYPE||'-'||SUBSTR(ltrim(rtrim(A.ACCOUNTNO)),-6,6)||' Tk. '||TO_CHAR(CREDIT_AMT,'FM99,99,999')||'/-, '  msg 
             FROM BANK_COLLECTION A, BANK_BRANCH_VIEW B, ZILIL_BANK_ACCOUNTS C
             WHERE A.BANKCODE=B.BANKCODE AND A.ROUTINGNO=B.ROUTINGNO AND TO_CHAR(A.INDATE,'YYYYMMDD')=TO_CHAR(SYSDATE,'YYYYMMDD')
             AND A.BANKCODE=C.BANKCODE AND A.ROUTINGNO=C.ROUTINGNO AND LTRIM(RTRIM(A.ACCOUNTNO))=LTRIM(RTRIM(C.ACCOUNTNO));
  
cursor v1 is SELECT sum(nvl(CREDIT_AMT,0)) FROM BANK_COLLECTION  where TO_CHAR(INDATE,'YYYYMMDD')=TO_CHAR(SYSDATE,'YYYYMMDD');

CURSOR T1 IS   select ROW_NUMBER() OVER (ORDER BY CODE) MSG_ID,MOBILE MSISDN,DSGN,CODE from mr_client 
where --DSGN='DIRECTOR' and code in ('01711537979','01711523051','01711521276','01711595766','01819227588','01711568541') AND TO_CHAR(DOB,'YYYY')<>'1966' 
--OR CODE IN ('00000048','00000204','00000493','00000004');
--CODE IN ('00000204','00000031');
CODE IN ('00000031');

V_SLNO VARCHAR2(25);

CURSOR SL1 IS SELECT MAX(SLNO)+1 FROM SMS.TOTAL_SMS;

BEGIN

OPEN SL1; FETCH SL1 INTO V_SLNO; CLOSE SL1;

NMSG1:='Dear Sir,
Todays bank collection: ';

--NMSG2:='/-.';
