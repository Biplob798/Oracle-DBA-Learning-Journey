Thanks,
Faruk Ahmed, 
VP (ACCOUNTS), Mob:01777776703.';

open v1; fetch v1 into COLLECTION; close v1;
NMSG2:=NMSG3||TO_CHAR(COLLECTION,'FM99,99,999')||NMSG2; 


FOR C2 IN C1 LOOP
   NMSG:=c2.msg;
   TMSG:=TMSG||NMSG;
END LOOP; 

TMSG:=substr(TMSG,0,length(TMSG)-2)||' ';
TMSG:=NMSG1||TMSG||NMSG2;

    IF NVL(COLLECTION,0)>0 THEN 
       
      FOR T2 IN T1 LOOP
        /*SMS.PD_SEMICON_SEND_SMS(T2.MSG_ID,T2.MSISDN,TMSG,BRAND_NAME);

