					WEB.SHOW_DOCUMENT(v_url||'/getjobid'||
					SUBSTR(v_rep, INSTR(v_rep,'_', -1)+1)||'?'||'server='||v_repserver, '_blank');
					
					--vc_url:='/reports/rwservlet?USERID=ACCOUNTS_MANAGEMENT/01730052777@SYSTEM&server=rep_wls_reports_www-zenith_asinst_1&report=D:/ACCOUNTS_MANAGEMENT/reports/DAILY_V_REPORT.rep&desformat=pdf' || '&destype=cache&P_1=' || :V_NO_PARAM || '&paramform=no';
					--WEB.SHOW_DOCUMENT(vc_url,'_blank')
				
				ELSE
					message('Report Failure'||v_rep_status);
				END IF;			
			
			 
			END;
