DECLARE
    v_repid             REPORT_OBJECT;
    v_rep               VARCHAR2(200);
    v_rep_status        VARCHAR2(200);
    v_url               VARCHAR2(2000);
    v_RepLoc            VARCHAR2(2000);
    v_repserver         VARCHAR2(500);
    v_report            VARCHAR2(1000);
    reportname          VARCHAR2(200) := 'DAILY_V_REPORT.rdf';
    pl_id               ParamList;
    vjob_id             VARCHAR2(100);

BEGIN

    HRD.Dpr_Run_Report_jobid('ACC',v_repserver,v_RepLoc,v_url);
    v_report := v_RepLoc || reportname;

    pl_id := Get_Parameter_List('tmpdata');

    IF NOT Id_Null(pl_id) THEN
        Destroy_Parameter_List(pl_id);
    END IF;

    pl_id := Create_Parameter_List('tmpdata');

    /* Report Parameters */
    Add_Parameter(pl_id,'PARAMFORM',TEXT_PARAMETER,'NO');
    Add_Parameter(pl_id,'P_1',TEXT_PARAMETER,:BLOCK3.V_NO_PARAM);
    Add_Parameter(pl_id,'P_2',TEXT_PARAMETER,:BLOCK3.V_YEAR_PARAM);


    /* Find Report Object */
    v_repid := FIND_REPORT_OBJECT('REPORT35');


    /* Report Properties */
    SET_REPORT_OBJECT_PROPERTY(v_repid,REPORT_FILENAME,v_report);

    SET_REPORT_OBJECT_PROPERTY(v_repid,REPORT_EXECUTION_MODE,BATCH);

    SET_REPORT_OBJECT_PROPERTY(v_repid,REPORT_COMM_MODE,SYNCHRONOUS);

    SET_REPORT_OBJECT_PROPERTY(v_repid,REPORT_DESTYPE, CACHE);

    SET_REPORT_OBJECT_PROPERTY(v_repid,REPORT_DESFORMAT,'PDF');

    SET_REPORT_OBJECT_PROPERTY(v_repid,REPORT_SERVER,v_repserver);


    /* Run Report */
    v_rep := RUN_REPORT_OBJECT(v_repid,pl_id);

    v_rep_status := REPORT_OBJECT_STATUS(v_rep);


    /* Wait until report finishes */
    WHILE v_rep_status IN
        ('RUNNING', 'OPENING_REPORT', 'ENQUEUED')
    LOOP

        v_rep_status := REPORT_OBJECT_STATUS(v_rep);

    END LOOP;


    /* Show Report */
    IF v_rep_status = 'FINISHED' THEN

        vjob_id :=SUBSTR(v_rep,INSTR(v_rep, '_', -1) + 1);

        WEB.SHOW_DOCUMENT(v_url ||'/getjobid' ||LTRIM(vjob_id, '_') ||'?server=' ||v_repserver,'_blank');

    ELSE

        MESSAGE(
            'Report Failure: ' || v_rep_status,
            NO_ACKNOWLEDGE
        );

    END IF;


EXCEPTION
    WHEN OTHERS THEN

        MESSAGE(
            'Error running report: ' || SQLERRM,
            NO_ACKNOWLEDGE
        );

END;

