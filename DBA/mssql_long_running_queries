/* =====================================================================
   SQL SERVER 2022 - LONG RUNNING QUERIES & LARGE TABLE DIAGNOSTICS
   (fixed version)

   How to use:
   - Run each section on its own (select it, then press F5).
   - Sections 7, 8, 10, 11, 13 work on ONE database: change USE HR; to
     the database you want to inspect.
   - Sections 1-6, 9, 12 are server-wide.
   - Dangerous commands (KILL, DELETE) are commented out on purpose.
   - Most of these need VIEW SERVER STATE (sysadmin has it).
   ===================================================================== */


/* ---------------------------------------------------------------------
   1. CURRENTLY RUNNING QUERIES (LIVE, LONGEST FIRST)
   --------------------------------------------------------------------- */
SELECT
    r.session_id,
    r.status,
    r.command,
    DB_NAME(r.database_id)                        AS database_name,
    r.start_time,
    DATEDIFF(SECOND, r.start_time, GETDATE())     AS running_seconds,
    r.cpu_time                                    AS cpu_ms,
    r.logical_reads,
    r.reads,
    r.writes,
    r.wait_type,
    r.wait_time                                   AS wait_ms,
    r.blocking_session_id,
    s.login_name,
    s.host_name,
    s.program_name,
    SUBSTRING(t.text, (r.statement_start_offset/2)+1,
        ((CASE r.statement_end_offset
            WHEN -1 THEN DATALENGTH(t.text)
            ELSE r.statement_end_offset END
          - r.statement_start_offset)/2)+1)       AS running_statement,
    t.text                                        AS full_batch_text
FROM sys.dm_exec_requests r
JOIN sys.dm_exec_sessions s ON s.session_id = r.session_id
OUTER APPLY sys.dm_exec_sql_text(r.sql_handle) t
WHERE r.session_id <> @@SPID
  AND s.is_user_process = 1
ORDER BY r.start_time ASC;
GO


/* ---------------------------------------------------------------------
   2. TOP 20 QUERIES BY TOTAL ELAPSED TIME (HISTORICAL, FROM PLAN CACHE)
      Note: only covers plans still in cache. Cleared on restart.
   --------------------------------------------------------------------- */
SELECT TOP 20
    qs.execution_count,
    qs.total_elapsed_time / 1000000.0                       AS total_elapsed_sec,
    qs.total_elapsed_time / qs.execution_count / 1000000.0  AS avg_elapsed_sec,
    qs.max_elapsed_time / 1000000.0                         AS max_elapsed_sec,
    qs.total_worker_time / 1000000.0                        AS total_cpu_sec,
    qs.total_logical_reads,
    qs.total_logical_reads / qs.execution_count             AS avg_logical_reads,
    qs.total_physical_reads,
    qs.last_execution_time,
    DB_NAME(CONVERT(INT, pa.value))                         AS database_name,
    SUBSTRING(st.text, (qs.statement_start_offset/2)+1,
        ((CASE qs.statement_end_offset
            WHEN -1 THEN DATALENGTH(st.text)
            ELSE qs.statement_end_offset END
          - qs.statement_start_offset)/2)+1)                AS query_text,
    qp.query_plan
FROM sys.dm_exec_query_stats qs
CROSS APPLY sys.dm_exec_sql_text(qs.sql_handle) st
OUTER APPLY sys.dm_exec_query_plan(qs.plan_handle) qp
OUTER APPLY (SELECT value
             FROM sys.dm_exec_plan_attributes(qs.plan_handle)
             WHERE attribute = 'dbid') pa
ORDER BY qs.total_elapsed_time DESC;
GO


/* ---------------------------------------------------------------------
   3. TOP 20 QUERIES BY CPU
   --------------------------------------------------------------------- */
SELECT TOP 20
    qs.total_worker_time / 1000000.0                    AS total_cpu_sec,
    qs.total_worker_time / qs.execution_count / 1000.0  AS avg_cpu_ms,
    qs.execution_count,
    qs.last_execution_time,
    SUBSTRING(st.text, (qs.statement_start_offset/2)+1,
        ((CASE qs.statement_end_offset
            WHEN -1 THEN DATALENGTH(st.text)
            ELSE qs.statement_end_offset END
          - qs.statement_start_offset)/2)+1)            AS query_text
FROM sys.dm_exec_query_stats qs
CROSS APPLY sys.dm_exec_sql_text(qs.sql_handle) st
ORDER BY qs.total_worker_time DESC;
GO


/* ---------------------------------------------------------------------
   4. TOP 20 QUERIES BY LOGICAL READS (LARGE TABLE SCAN CULPRITS)
   --------------------------------------------------------------------- */
SELECT TOP 20
    qs.total_logical_reads,
    qs.total_logical_reads / qs.execution_count         AS avg_logical_reads,
    qs.execution_count,
    qs.total_elapsed_time / 1000000.0                   AS total_elapsed_sec,
    SUBSTRING(st.text, (qs.statement_start_offset/2)+1,
        ((CASE qs.statement_end_offset
            WHEN -1 THEN DATALENGTH(st.text)
            ELSE qs.statement_end_offset END
          - qs.statement_start_offset)/2)+1)            AS query_text,
    qp.query_plan
FROM sys.dm_exec_query_stats qs
CROSS APPLY sys.dm_exec_sql_text(qs.sql_handle) st
OUTER APPLY sys.dm_exec_query_plan(qs.plan_handle) qp
ORDER BY qs.total_logical_reads DESC;
GO


/* ---------------------------------------------------------------------
   5. BLOCKING CHAINS (WHO IS BLOCKING WHOM)
      Returns no rows when nothing is blocked (that is the good result).
   --------------------------------------------------------------------- */
SELECT
    w.session_id                  AS blocked_session,
    w.blocking_session_id         AS blocking_session,
    w.wait_type,
    w.wait_duration_ms / 1000     AS wait_seconds,
    w.resource_description,
    bt.text                       AS blocked_query,
    bl.text                       AS blocking_query
FROM sys.dm_os_waiting_tasks w
LEFT JOIN sys.dm_exec_requests r    ON r.session_id = w.session_id
OUTER APPLY sys.dm_exec_sql_text(r.sql_handle) bt
LEFT JOIN sys.dm_exec_connections c ON c.session_id = w.blocking_session_id
OUTER APPLY sys.dm_exec_sql_text(c.most_recent_sql_handle) bl
WHERE w.blocking_session_id IS NOT NULL
  AND w.blocking_session_id <> w.session_id;
GO


/* ---------------------------------------------------------------------
   6. OPEN / LONG-RUNNING TRANSACTIONS
      (aliases renamed: "at" is a keyword in T-SQL, so avoid it)
   --------------------------------------------------------------------- */
SELECT
    sess_tran.session_id,
    s.login_name,
    s.host_name,
    act_tran.transaction_id,
    act_tran.name                                                AS transaction_name,
    act_tran.transaction_begin_time,
    DATEDIFF(MINUTE, act_tran.transaction_begin_time, GETDATE()) AS open_minutes,
    s.status
FROM sys.dm_tran_session_transactions sess_tran
JOIN sys.dm_tran_active_transactions act_tran
     ON act_tran.transaction_id = sess_tran.transaction_id
JOIN sys.dm_exec_sessions s
     ON s.session_id = sess_tran.session_id
ORDER BY act_tran.transaction_begin_time;
GO

