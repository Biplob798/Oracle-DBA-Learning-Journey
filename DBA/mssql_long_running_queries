/* ---------------------------------------------------------------------
   7. LARGEST TABLES  (database-specific)
      FIX: the old version joined sys.allocation_units, which has up to 3
      rows per partition (in-row, LOB, row-overflow). That multiplied the
      row count for tables with LOB columns and left out nonclustered index
      space. sys.dm_db_partition_stats avoids both problems.
      total_mb / used_mb here INCLUDE all indexes on the table.
   --------------------------------------------------------------------- */
USE HR;
GO
SELECT TOP 30
    s.name + '.' + t.name                                   AS table_name,
    SUM(CASE WHEN ps.index_id < 2 THEN ps.row_count ELSE 0 END) AS row_count,
    CAST(SUM(ps.reserved_page_count) * 8.0 / 1024 AS DECIMAL(14,2)) AS total_mb,
    CAST(SUM(ps.used_page_count)     * 8.0 / 1024 AS DECIMAL(14,2)) AS used_mb
FROM sys.dm_db_partition_stats ps
JOIN sys.tables  t ON t.object_id = ps.object_id
JOIN sys.schemas s ON s.schema_id = t.schema_id
GROUP BY s.name, t.name
ORDER BY total_mb DESC;
GO


/* ---------------------------------------------------------------------
   8. INDEX SCANS ON TABLES  (database-specific)
      A high user_scans on a BIG table with few seeks suggests a missing
      or unusable index. Scans on tiny tables are normal.
      Counters reset when the instance restarts.
   --------------------------------------------------------------------- */
USE HR;
GO
SELECT
    OBJECT_SCHEMA_NAME(ius.object_id) + '.' + OBJECT_NAME(ius.object_id) AS table_name,
    i.name                      AS index_name,
    ius.user_scans,
    ius.user_seeks,
    ius.user_lookups,
    ius.user_updates,
    ius.last_user_scan
FROM sys.dm_db_index_usage_stats ius
JOIN sys.indexes i ON i.object_id = ius.object_id AND i.index_id = ius.index_id
JOIN sys.objects o ON o.object_id = ius.object_id
WHERE ius.database_id = DB_ID()
  AND o.is_ms_shipped = 0
  AND ius.user_scans > 0
ORDER BY ius.user_scans DESC;
GO


/* ---------------------------------------------------------------------
   9. MISSING INDEX RECOMMENDATIONS (RANKED BY IMPACT, SERVER-WIDE)
      Treat these as hints, not commands. Consolidate overlapping
      suggestions before creating indexes. The list resets on restart.
   --------------------------------------------------------------------- */
SELECT TOP 20
    DB_NAME(mid.database_id)                    AS database_name,
    OBJECT_NAME(mid.object_id, mid.database_id) AS table_name,
    migs.avg_total_user_cost * migs.avg_user_impact
        * (migs.user_seeks + migs.user_scans)   AS improvement_score,
    migs.user_seeks,
    migs.user_scans,
    mid.equality_columns,
    mid.inequality_columns,
    mid.included_columns
FROM sys.dm_db_missing_index_group_stats migs
JOIN sys.dm_db_missing_index_groups mig  ON mig.index_group_handle = migs.group_handle
JOIN sys.dm_db_missing_index_details mid ON mid.index_handle = mig.index_handle
ORDER BY improvement_score DESC;
GO


/* ---------------------------------------------------------------------
   10. INDEX FRAGMENTATION ON LARGER INDEXES  (database-specific)
       10% - 30%  -> ALTER INDEX <name> ON <table> REORGANIZE;
       Over 30%   -> ALTER INDEX <name> ON <table> REBUILD;
       Heaps (no name) are skipped. Can be slow on big databases: run
       it off-peak.
   --------------------------------------------------------------------- */
USE HR;
GO
SELECT
    OBJECT_SCHEMA_NAME(ips.object_id) + '.' + OBJECT_NAME(ips.object_id) AS table_name,
    i.name                      AS index_name,
    ips.avg_fragmentation_in_percent,
    ips.page_count
FROM sys.dm_db_index_physical_stats(DB_ID(), NULL, NULL, NULL, 'LIMITED') ips
JOIN sys.indexes i ON i.object_id = ips.object_id AND i.index_id = ips.index_id
WHERE i.name IS NOT NULL
  AND ips.page_count > 1000
  AND ips.avg_fragmentation_in_percent > 10
ORDER BY ips.avg_fragmentation_in_percent DESC;
GO


/* ---------------------------------------------------------------------
   11. OUTDATED STATISTICS  (database-specific)
       Update manually:  UPDATE STATISTICS dbo.YourTable WITH FULLSCAN;
   --------------------------------------------------------------------- */
USE HR;
GO
SELECT
    OBJECT_SCHEMA_NAME(s.object_id) + '.' + OBJECT_NAME(s.object_id) AS table_name,
    s.name                      AS stat_name,
    sp.last_updated,
    sp.rows,
    sp.modification_counter,
    CAST(100.0 * sp.modification_counter / NULLIF(sp.rows, 0) AS DECIMAL(10,2)) AS pct_modified
FROM sys.stats s
CROSS APPLY sys.dm_db_stats_properties(s.object_id, s.stats_id) sp
WHERE OBJECTPROPERTY(s.object_id, 'IsUserTable') = 1
  AND sp.modification_counter > 0
ORDER BY sp.modification_counter DESC;
GO


/* ---------------------------------------------------------------------
   12. TOP WAIT TYPES (WHAT THE SERVER IS ACTUALLY WAITING ON)
       Cumulative since the last restart. Benign idle waits are filtered.
   --------------------------------------------------------------------- */
SELECT TOP 15
    wait_type,
    wait_time_ms / 1000.0                            AS wait_sec,
    waiting_tasks_count,
    CAST(100.0 * wait_time_ms / SUM(wait_time_ms) OVER() AS DECIMAL(5,2)) AS pct
FROM sys.dm_os_wait_stats
WHERE wait_time_ms > 0
  AND wait_type NOT IN (
    'SLEEP_TASK','BROKER_TASK_STOP','SQLTRACE_BUFFER_FLUSH','CLR_AUTO_EVENT',
    'LAZYWRITER_SLEEP','XE_TIMER_EVENT','REQUEST_FOR_DEADLOCK_SEARCH',
    'DIRTY_PAGE_POLL','HADR_FILESTREAM_IOMGR_IOCOMPLETION','LOGMGR_QUEUE',
    'CHECKPOINT_QUEUE','WAITFOR','XE_DISPATCHER_WAIT','BROKER_TO_FLUSH',
    'SP_SERVER_DIAGNOSTICS_SLEEP','QDS_PERSIST_TASK_MAIN_LOOP_SLEEP',
    'SLEEP_SYSTEMTASK','SLEEP_BPOOL_FLUSH','SQLTRACE_INCREMENTAL_FLUSH_SLEEP',
    'BROKER_EVENTHANDLER','BROKER_RECEIVE_WAITFOR','FT_IFTS_SCHEDULER_IDLE_WAIT',
    'XE_DISPATCHER_JOIN','ONDEMAND_TASK_QUEUE','HADR_WORK_QUEUE',
    'HADR_CLUSAPI_CALL','QDS_CLEANUP_STALE_QUERIES_TASK_MAIN_LOOP_SLEEP',
    'QDS_SHUTDOWN_QUEUE','SOS_WORK_DISPATCHER','PWAIT_ALL_COMPONENTS_INITIALIZED')
ORDER BY wait_time_ms DESC;
GO


/* ---------------------------------------------------------------------
   13. QUERY STORE: SLOWEST QUERIES OVER TIME  (database-specific)
       Query Store must be ON for the database, otherwise this returns
       nothing. In SQL Server 2022 it is ON by default for NEW databases;
       an older/restored database may need it turned on:
           ALTER DATABASE HR SET QUERY_STORE = ON;
       Durations are in microseconds, so / 1000 gives milliseconds.
   --------------------------------------------------------------------- */
USE HR;
GO
SELECT TOP 20
    q.query_id,
    qt.query_sql_text,
    SUM(rs.count_executions)        AS executions,
    AVG(rs.avg_duration) / 1000.0   AS avg_duration_ms,
    MAX(rs.max_duration) / 1000.0   AS max_duration_ms,
    AVG(rs.avg_logical_io_reads)    AS avg_reads
FROM sys.query_store_query q
JOIN sys.query_store_query_text qt    ON qt.query_text_id = q.query_text_id
JOIN sys.query_store_plan p           ON p.query_id = q.query_id
JOIN sys.query_store_runtime_stats rs ON rs.plan_id = p.plan_id
GROUP BY q.query_id, qt.query_sql_text
ORDER BY avg_duration_ms DESC;
GO


