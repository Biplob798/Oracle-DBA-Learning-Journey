/* =====================================================================
   SQL Server 2022 - HR database admin queries (fixed version)
   Run in SSMS. Run each section on its own (select it, then press F5).
   Sections marked DANGEROUS are commented out on purpose.
   ===================================================================== */


/* ---------------------------------------------------------------------
   1. SERVER VERSION
   --------------------------------------------------------------------- */
SELECT @@VERSION AS FullVersion;

SELECT SERVERPROPERTY('ProductVersion') AS ProductVersion,
       SERVERPROPERTY('ProductLevel')   AS ProductLevel,
       SERVERPROPERTY('Edition')        AS Edition;
GO


/* ---------------------------------------------------------------------
   2. CREATE DATABASE (only if it does not exist yet)
   --------------------------------------------------------------------- */
IF DB_ID('HR') IS NULL
    CREATE DATABASE HR;
GO


/* ---------------------------------------------------------------------
   3. SWITCH DATABASE + CHECK CURRENT DATABASE
   --------------------------------------------------------------------- */
USE HR;
GO
SELECT DB_NAME() AS CurrentDatabase;
GO


/* ---------------------------------------------------------------------
   4. SAMPLE TABLE (so the table-size queries have something to show)
   --------------------------------------------------------------------- */
USE HR;
GO
IF OBJECT_ID('dbo.Employees', 'U') IS NULL
BEGIN
    CREATE TABLE dbo.Employees
    (
        EmployeeID INT IDENTITY(1,1) PRIMARY KEY,
        FullName   NVARCHAR(100) NOT NULL,
        Salary     DECIMAL(10,2) NULL,
        HireDate   DATE          NULL
    );

    INSERT INTO dbo.Employees (FullName, Salary, HireDate)
    VALUES (N'Alice Rahman', 55000, '2022-01-10'),
           (N'Bob Karim',    48000, '2023-03-15'),
           (N'Carol Hasan',  62000, '2021-07-01');
END
GO


/* ---------------------------------------------------------------------
   5. DATABASE SIZE
   --------------------------------------------------------------------- */
USE HR;
GO
EXEC sp_spaceused;                    -- whole database
EXEC sp_spaceused 'dbo.Employees';    -- one table (schema.table)
GO


/* ---------------------------------------------------------------------
   6. DETAILED SIZE PER TABLE (replaces undocumented sp_MSforeachtable)
   --------------------------------------------------------------------- */
USE HR;
GO
SELECT s.name + '.' + t.name AS TableName,
       SUM(CASE WHEN i.index_id < 2 THEN p.rows ELSE 0 END) AS RowCnt,
       CAST(SUM(a.total_pages) * 8.0 / 1024 AS DECIMAL(12,2)) AS TotalMB,
       CAST(SUM(a.used_pages)  * 8.0 / 1024 AS DECIMAL(12,2)) AS UsedMB
FROM sys.tables t
JOIN sys.schemas s          ON t.schema_id = s.schema_id
JOIN sys.indexes i          ON t.object_id = i.object_id
JOIN sys.partitions p       ON i.object_id = p.object_id AND i.index_id = p.index_id
JOIN sys.allocation_units a ON p.partition_id = a.container_id
GROUP BY s.name, t.name
ORDER BY TotalMB DESC;
GO


/* ---------------------------------------------------------------------
   7. DATABASE FILE INFORMATION (MDF / LDF locations and size)
   --------------------------------------------------------------------- */
USE master;
GO
SELECT name          AS LogicalFileName,
       type_desc     AS FileType,
       physical_name AS FileLocation,
       CAST(size * 8.0 / 1024 AS DECIMAL(12,2)) AS SizeMB
FROM sys.master_files
WHERE database_id = DB_ID('HR');
GO


/* ---------------------------------------------------------------------
   8. LIST ALL DATABASES
   --------------------------------------------------------------------- */
SELECT name, state_desc, recovery_model_desc
FROM sys.databases
ORDER BY name;
GO


/* ---------------------------------------------------------------------
   9. READ-ONLY CHECK   (is_read_only: 0 = read-write, 1 = read-only)
   --------------------------------------------------------------------- */
SELECT name AS DatabaseName, is_read_only
FROM sys.databases
WHERE name = 'HR';
GO


/* ---------------------------------------------------------------------
   10. SET READ-ONLY / READ-WRITE  (run from master)
   --------------------------------------------------------------------- */
USE master;
GO
-- ALTER DATABASE HR SET READ_ONLY;
-- ALTER DATABASE HR SET READ_WRITE;
GO


/* ---------------------------------------------------------------------
   11. DATABASE STATE AND USER ACCESS MODE
   --------------------------------------------------------------------- */
SELECT name AS DatabaseName, state_desc, user_access_desc
FROM sys.databases;
GO


/* ---------------------------------------------------------------------
   12. ACTIVE CONNECTIONS TO HR (your own session excluded)
   --------------------------------------------------------------------- */
SELECT session_id, login_name, status, host_name, program_name
FROM sys.dm_exec_sessions
WHERE database_id = DB_ID('HR')
  AND is_user_process = 1
  AND session_id <> @@SPID;
GO


/* ---------------------------------------------------------------------
   13. TRANSACTIONAL REPLICATION COUNTERS
       Run on the PUBLISHER only. Returns nothing if replication is not set up.
   --------------------------------------------------------------------- */
EXEC sp_replcounters;
GO


/* ---------------------------------------------------------------------
   14. KILL ALL CONNECTIONS  -- DANGEROUS
       Disconnects everyone and ROLLS BACK their open transactions.
       Always set MULTI_USER again afterwards.
   --------------------------------------------------------------------- */
USE master;
GO
-- ALTER DATABASE HR SET SINGLE_USER WITH ROLLBACK IMMEDIATE;
-- ALTER DATABASE HR SET MULTI_USER;     -- put it back when finished
