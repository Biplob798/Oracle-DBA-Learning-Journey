/* ---------------------------------------------------------------------
   16. SERVER-LEVEL LOGINS  (Layer 1)
       S = SQL login, U = Windows login, G = Windows group
   --------------------------------------------------------------------- */
SELECT name AS LoginName,
       type_desc AS LoginType,
       create_date,
       default_database_name,
       is_disabled
FROM sys.server_principals
WHERE type IN ('S', 'U', 'G')
ORDER BY name;
GO


/* ---------------------------------------------------------------------
   17. SERVER ROLE MEMBERSHIP (e.g. sysadmin)
       Logins with no server role are not listed.
   --------------------------------------------------------------------- */
SELECT sp.name      AS LoginName,
       sp.type_desc AS LoginType,
       sr.name      AS ServerRole
FROM sys.server_principals sp
JOIN sys.server_role_members srm ON sp.principal_id = srm.member_principal_id
JOIN sys.server_principals sr    ON srm.role_principal_id = sr.principal_id
ORDER BY sr.name, sp.name;
GO


/* ---------------------------------------------------------------------
   18. DATABASE USERS AND THEIR ROLES  (Layer 2) - run inside HR
   --------------------------------------------------------------------- */
USE HR;
GO
SELECT dp.name      AS UserName,
       dp.type_desc AS UserType,
       dp.create_date,
       rp.name      AS RoleName          -- NULL = user has no role
FROM sys.database_principals dp
LEFT JOIN sys.database_role_members drm ON dp.principal_id = drm.member_principal_id
LEFT JOIN sys.database_principals rp    ON drm.role_principal_id = rp.principal_id
WHERE dp.type IN ('S', 'U', 'G')
ORDER BY dp.name;
GO


/* ---------------------------------------------------------------------
   19. DATABASE PERMISSIONS  (Layer 3) - run inside HR
       ObjectName NULL = database-level permission
   --------------------------------------------------------------------- */
USE HR;
GO
SELECT dp.name           AS PrincipalName,
       dp.type_desc      AS PrincipalType,
       perm.class_desc   AS PermissionClass,
       perm.permission_name,
       perm.state_desc   AS PermissionState,
       OBJECT_SCHEMA_NAME(perm.major_id) + '.' + OBJECT_NAME(perm.major_id) AS ObjectName
FROM sys.database_permissions perm
JOIN sys.database_principals dp ON perm.grantee_principal_id = dp.principal_id
ORDER BY dp.name, perm.permission_name;
GO


/* ---------------------------------------------------------------------
   20. SQL SERVER AGENT JOBS (with readable next-run time)
       Needs SQL Server Agent (not available in Express).
   --------------------------------------------------------------------- */
SELECT job.name,
       job.enabled,
       sch.name AS ScheduleName,
       CASE WHEN js.next_run_date = 0 THEN NULL
            ELSE msdb.dbo.agent_datetime(js.next_run_date, js.next_run_time)
       END AS NextRun
FROM msdb.dbo.sysjobs job
LEFT JOIN msdb.dbo.sysjobschedules js ON job.job_id = js.job_id
LEFT JOIN msdb.dbo.sysschedules sch   ON js.schedule_id = sch.schedule_id
ORDER BY job.name;
GO