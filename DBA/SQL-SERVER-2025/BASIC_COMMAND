-- Case Statement

SELECT 
    p.Name,
    CASE 
        WHEN p.email1 IS NULL THEN 'N/A' 
        ELSE p.email1 
    END AS [Email1],
    CASE 
        WHEN p.email2 IS NULL THEN 'N/A' 
        ELSE p.email2 
    END AS [Email2]
FROM person p;



-- Coalesce() function and Case Statement compairison [use coalesce() function to get the first non-null value from a list of expressions]

SELECT 
    [Name], 
    COALESCE(Email1, Email2) AS email
FROM person;


SELECT 
    [Name], 
    CASE 
        WHEN email1 IS NULL THEN email2
        ELSE email1 
    END AS email 
FROM person;



