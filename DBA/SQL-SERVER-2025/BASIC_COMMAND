-- Having clause 

SELECT 
    p.BrandName,
    MAX(p.price) AS [Max price],
    MIN(p.price) AS [Min price]
FROM products p
GROUP BY p.BrandName
Having sum(p.Price) < 500;


SELECT 
    p.BrandName,
    MAX(p.price) AS [Max price],
    MIN(p.price) AS [Min price]
FROM products p
WHERE p.AvailableStock > 100
GROUP BY p.BrandName
HAVING SUM(p.Price) < 500 AND AVG(p.Price) < 100;

-- IF, ELSE, CASE statements


-- if-else statement
-- 1 => Logitech; 2 => Samsung; 3 3=> Apple;

DECLARE @BrandId INT = 1;

IF @BrandId = 1
BEGIN
    SELECT * 
    FROM Products 
    WHERE BrandName = 'Logitech';
END
ELSE IF @BrandId = 2
BEGIN
    SELECT * 
    FROM Products 
    WHERE BrandName = 'Samsung';
END
ELSE IF @BrandId = 3
BEGIN
    SELECT * 
    FROM Products 
    WHERE BrandName = 'Apple';
END
ELSE
BEGIN
SELECT * FROM PRODUCTS
END;


-- case statement
-- Case Statement inside select
-- price < 100 => Low
-- 100<= price < 200 => Mid
-- price >= 200 => High


SELECT 
    *, 
    CASE 
        WHEN Price < 100 THEN 'Low'
        WHEN Price >= 100 AND Price < 200 THEN 'Mid'
        ELSE 'High' 
    END AS [Price Range]
FROM products;


-- Case Statement inside where clause
-- price < 100 => Low
-- 100<= price < 200 => Mid
-- price >= 200 => High


DECLARE @BrandId INT = 1;

SELECT 
    *, 
    CASE 
        WHEN Price < 100 THEN 'Low'
        WHEN Price >= 100 AND Price < 200 THEN 'Mid'
        ELSE 'High' 
    END AS [Price Range]
FROM products
WHERE BrandName = CASE 
                    WHEN @BrandId = 1 THEN 'Logitech'
                    WHEN @BrandId = 2 THEN 'Samsung'
                    WHEN @BrandId = 3 THEN 'Apple'
                  END;
